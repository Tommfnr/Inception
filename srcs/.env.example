# ============================================================
#  Inception - modele de configuration (.env.example)
# ------------------------------------------------------------
#  Copie ce fichier en "srcs/.env" et remplis les valeurs.
#  Le vrai .env est ignore par git (voir .gitignore).
#
#  IMPORTANT :
#   - AUCUN mot de passe ici. Les mots de passe vont dans
#     secrets/ (db_password.txt, db_root_password.txt, ...)
#     et sont lus via Docker secrets.
#   - PAS de commentaire en fin de ligne apres une valeur :
#     docker --env-file l'inclurait DANS la valeur (bug vecu).
#     Commentaires uniquement sur des lignes dediees, comme ici.
# ============================================================

# --- Domaine ---
DOMAIN_NAME=tfournie.42.fr

# --- MariaDB / MySQL ---
MYSQL_DATABASE=wordpress
# valeur exemple : tfournie
MYSQL_USER=

# --- WordPress : administrateur ---
# ATTENTION : le nom de l'admin ne doit PAS contenir
# admin / Admin / administrator / Administrator (echec sinon)
# valeur exemple : bossman
WP_ADMIN_USER=
WP_ADMIN_EMAIL=

# --- WordPress : second utilisateur (obligatoire, 2 users) ---
WP_USER=
WP_USER_EMAIL=

# --- WordPress : site ---
WP_TITLE=Inception
WP_URL=https://tfournie.42.fr
